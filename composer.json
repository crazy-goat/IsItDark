{
    "name": "crazy-goat/is-it-dark",
    "description": "PHP library that determines whether it is dark at a given geographic location and point in time",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "CrazyGoat\\IsItDark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CrazyGoat\\IsItDark\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "bin/lint.sh",
        "lint-fix": "bin/lint.sh --fix",
        "test": "phpunit"
    }
}
